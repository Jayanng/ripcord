{
  "name": "@ripcord/core",
  "version": "0.1.0",
  "description": "Verified TypeScript core library for Tachi/Taurus regtest wallet mechanics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jayanng/ripcord.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Jayanng/ripcord/issues"
  },
  "homepage": "https://github.com/Jayanng/ripcord/tree/main/packages/core#readme",
  "keywords": ["bitcoin", "tachi", "taurus", "vtxo", "taproot", "self-custody"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./store": {
      "import": "./dist/store.js",
      "types": "./dist/store.d.ts"
    },
    "./health": {
      "import": "./dist/health.js",
      "types": "./dist/health.d.ts"
    },
    "./exit": {
      "import": "./dist/exit.js",
      "types": "./dist/exit.d.ts"
    },
    "./vault": {
      "import": "./dist/vault.js",
      "types": "./dist/vault.d.ts"
    },
    "./indexer": {
      "import": "./dist/indexer.js",
      "types": "./dist/indexer.d.ts"
    },
    "./keys": {
      "import": "./dist/keys.js",
      "types": "./dist/keys.d.ts"
    },
    "./quorum": {
      "import": "./dist/quorum.js",
      "types": "./dist/quorum.d.ts"
    },
    "./recovery": {
      "import": "./dist/recovery.js",
      "types": "./dist/recovery.d.ts"
    },
    "./payment": {
      "import": "./dist/payment.js",
      "types": "./dist/payment.d.ts"
    },
    "./lifecycle": {
      "import": "./dist/lifecycle.js",
      "types": "./dist/lifecycle.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@tachibtc/tachi-sdk-ts": "0.2.1",
    "@tachibtc/taurus-vault-core": "0.3.3",
    "@tachibtc/taurus-wallet-aggregator": "0.4.3",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
