{
  "name": "@ripcord/core",
  "version": "0.2.1",
  "description": "Verified TypeScript core library for Tachi/Taurus Bitcoin vaults: keys, quorum, deposits, VTXO payments with per-input scripts, live indexing with receipts, proofs, and unilateral exit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jayanng/ripcord.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Jayanng/ripcord/issues"
  },
  "homepage": "https://github.com/Jayanng/ripcord/tree/main/packages/core#readme",
  "keywords": [
    "bitcoin",
    "tachi",
    "taurus",
    "vtxo",
    "taproot",
    "self-custody"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "import": "./dist/bytes.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "import": "./dist/net.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js"
    },
    "./sentinel": {
      "types": "./dist/sentinel.d.ts",
      "import": "./dist/sentinel.js"
    },
    "./exit": {
      "types": "./dist/exit.d.ts",
      "import": "./dist/exit.js"
    },
    "./exit-certificate": {
      "types": "./dist/exitCertificate.d.ts",
      "import": "./dist/exitCertificate.js"
    },
    "./spend-conscience": {
      "types": "./dist/spendConscience.d.ts",
      "import": "./dist/spendConscience.js"
    },
    "./refund": {
      "types": "./dist/refund.d.ts",
      "import": "./dist/refund.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js"
    },
    "./indexer": {
      "types": "./dist/indexer.d.ts",
      "import": "./dist/indexer.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    },
    "./quorum": {
      "types": "./dist/quorum.d.ts",
      "import": "./dist/quorum.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    },
    "./payment": {
      "types": "./dist/payment.d.ts",
      "import": "./dist/payment.js"
    },
    "./proofs": {
      "types": "./dist/proofs.d.ts",
      "import": "./dist/proofs.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./coinselect": {
      "types": "./dist/coinselect.d.ts",
      "import": "./dist/coinselect.js"
    },
    "./deposit": {
      "types": "./dist/deposit.d.ts",
      "import": "./dist/deposit.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./idle-timer": {
      "types": "./dist/idleTimer.d.ts",
      "import": "./dist/idleTimer.js"
    },
    "./address-safety": {
      "types": "./dist/addressSafety.d.ts",
      "import": "./dist/addressSafety.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@tachibtc/taurus-vault-core": "0.3.3",
    "@tachibtc/taurus-wallet-aggregator": "0.4.3",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "@types/node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "sideEffects": false
}